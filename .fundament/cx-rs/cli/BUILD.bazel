load("//:defs.bzl", "MACOS_WEBRTC_RUSTC_LINK_FLAGS", "cx_rust_crate")
load("//bazel/platforms:release_binaries.bzl", "multiplatform_binaries")
load("//bazel/rules:e2e_benchmark.bzl", "cx_e2e_benchmark")

cx_rust_crate(
    name = "cli",
    crate_name = "cx_cli",
    extra_binaries = [
        "//cx-rs/bwrap:bwrap",
    ],
    rustc_flags_extra = MACOS_WEBRTC_RUSTC_LINK_FLAGS,
    test_data_extra = glob(["src/**/snapshots/**"]),
)

multiplatform_binaries(
    name = "cx",
)

cx_e2e_benchmark(
    name = "cx-help",
    binaries = [":cx"],
)
